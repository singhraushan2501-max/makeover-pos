{
  "name": "makeover-by-nitu-sharma-pos",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Offline POS for macOS, iPhone and iPad",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "mac:package": "electron-builder --mac",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "better-sqlite3": "^12.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  },
  "build": {
    "appId": "com.makeoverbynitusharma.pos",
    "productName": "Makeover POS",
    "files": ["web/**/*", "electron/**/*", "package.json"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.business" }
  }
}
